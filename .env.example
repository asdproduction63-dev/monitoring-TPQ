# --- Mode Supabase / Postgres (dipakai saat deploy) ---
# Supabase: Project Settings > Database > Connection string > URI.
# Gunakan Session pooler / Direct connection untuk Prisma.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?schema=public&sslmode=require"
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Alamat publik aplikasi setelah dideploy, misalnya https://tpq.vercel.app
# Dipakai untuk menyisipkan tautan raport pada pesan WhatsApp ke wali murid.
# Boleh dikosongkan; tautannya hanya tidak ikut disertakan.
APP_URL=""

# --- Mode lokal tanpa Supabase ---
# Tidak perlu mengubah DATABASE_URL di atas. Jalankan:
#
#   npm run dev:local
#
# Perintah itu membuat database SQLite di prisma/local.db, mengisinya dengan
# data awal, lalu menjalankan dev server di atasnya. DATABASE_URL di .env
# diabaikan selama mode ini. "npm run dev" biasa kembali memakai Postgres.
