{
  "name": "santri-monitor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "dev:local": "node prisma/local.mjs dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:local": "node prisma/local.mjs setup",
    "db:local:reset": "node prisma/local.mjs setup --reset",
    "db:migrate:sqlite": "node prisma/migrate-sqlite.mjs",
    "db:reset": "prisma db push --force-reset && prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
